# Build directory — generated by CMake, not needed in the repo.
/build/

# Other build artifacts
*.exe
*.o
*.obj

# Save files — created at runtime by the game/server, not needed in the repo.
savegame.json
account.json
world.json

# clangd index cache (IDE) — local, generated, not needed in the repo.
.cache/

# Internal working notes (kept local, not part of the public repo).
# CLAUDE.md is deliberately NOT here: it is operating context for AI assistants
# working in this repository, and this project treats agents as contributors.
documents/dev_journal_L.md
documents/mmo_transition_plan.md
documents/mmo_m4_plan.md
documents/living_galaxy_next.md
