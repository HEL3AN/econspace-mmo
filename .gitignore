# Build directory — generated by CMake, not needed in the repo.
/build/

# Other build artifacts
*.exe
*.o
*.obj

# Save files -- written at runtime by the server next to its executable. A player's
# account is account_<name>.json since accounts became per-player (#49), kept in accounts/
# beside world.json since #392; ignored by pattern so that running a server from anywhere
# inside the repository cannot put someone's save one `git add .` away from the history.
savegame.json
account.json
account_*.json
accounts/
world.json
# The rest of a world folder: sealed regions and the archive (#342), corporations (#347),
# player designs (#279), who may come in (#400), and the copies a save keeps (#341).
regions/
corps.json
designs.json
allowlist.txt
bans.txt
*.bak[0-9]*
# The client's window layout, per account on this machine (#297): a preference, not data.
ui_layout.json
ui_navigation.json

# clangd index cache (IDE) — local, generated, not needed in the repo.
.cache/

# Private working notes: keep them in documents/private/ and they stay local. A
# directory rather than a list of filenames, because a list of names in a public file
# advertises what is being kept out of it.
# CLAUDE.md is deliberately NOT ignored: it is operating context for AI assistants
# working in this repository, and this project treats agents as contributors.
documents/private/

# Parallel agents work in worktrees here; never part of the repository.
.claude/worktrees/
# One machine's Claude Code settings for this project (e.g. where its memory lives).
.claude/settings.local.json
__pycache__/
build-release/
