#pragma once

// Which build this is (#400). Generated by CMake from `project(EconSpace VERSION ...)` and the
// codename table beside it, which are the one place a version is written: edit those, never
// the generated core/Version.h.
//
// NUMBER is the semver a release is tagged with (v0.1.0) and what a client and a server
// compare before they let each other in. NAME is what a player reads: the minor version and
// its codename, "EconSpace 0.1 Anchor"; a patch release shows its full number.
namespace Version
{
inline constexpr int         MAJOR = @PROJECT_VERSION_MAJOR@;
inline constexpr int         MINOR = @PROJECT_VERSION_MINOR@;
inline constexpr int         PATCH = @PROJECT_VERSION_PATCH@;
inline constexpr const char* NUMBER = "@PROJECT_VERSION@";
inline constexpr const char* CODENAME = "@ECON_CODENAME@";
inline constexpr const char* NAME = "EconSpace @ECON_VERSION_SHORT@ @ECON_CODENAME@";
// Where a player gets the build a server runs, named when one is refused.
inline constexpr const char* RELEASES_URL = "@ECON_RELEASES_URL@";
}  // namespace Version
